# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by local scripts, never by the app at runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site, for share previews. Leave empty locally.
NEXT_PUBLIC_SITE_URL=

# Cloudinary (photo and video hosting): Settings → API Keys. Server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phone notifications (web push). Generate a key pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://dalin.pics
# The secret migration 0011 created: select value from private.app_config where key = 'push_secret';
PUSH_SECRET=
# Any long random string; Vercel Cron sends it to /api/cron/push.
CRON_SECRET=
