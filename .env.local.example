# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by local scripts, never by the app at runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site, for share previews. Leave empty locally.
NEXT_PUBLIC_SITE_URL=

# Cloudinary (photo and video hosting): Settings → API Keys. Server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
